# Vite dev-server proxy targets for a backend that serves /api and /ws.
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_WS_PROXY_TARGET=http://localhost:3000
VITE_UPLOADS_PROXY_TARGET=http://localhost:3000

# Optional: call the API directly instead of using the Vite proxy.
# VITE_API_BASE_URL=https://api.example.com/api

# Optional: full WebSocket URL. {id} is replaced with the room ID.
# VITE_WS_BASE_URL=wss://api.example.com/ws/groups/{id}